# Copia este archivo como backend/.env y completa los valores. NUNCA subas .env a GitHub.
APP_ENV=development
SECRET_KEY=cambia-esto-por-una-clave-larga-generada-con-secrets-token_hex
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/civil_tools
JWT_EXPIRES_HOURS=12
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ALLOW_REGISTRATION=true

# Solo para el script create_admin.py (puedes dejar la contraseña vacía y se te pedirá por teclado)
ADMIN_EMAIL=admin@civiltools.local
ADMIN_PASSWORD=
